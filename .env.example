# JANASEVA OS — Environment Configuration
# Copy this file to .env and fill in values before running locally.
# NEVER commit the real .env file.

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

# =============================================================================
# DATABASE (PostgreSQL + PostGIS + pgvector)
# =============================================================================
POSTGRES_DB=janaseva
POSTGRES_USER=janaseva
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://janaseva:CHANGE_ME_strong_password@db:5432/janaseva

# Alembic sync URL (used during migrations only)
DATABASE_SYNC_URL=postgresql+psycopg2://janaseva:CHANGE_ME_strong_password@db:5432/janaseva

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# =============================================================================
# JWT AUTH
# =============================================================================
JWT_SECRET_KEY=CHANGE_ME_another_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# OBJECT STORAGE (MinIO for local dev / S3-compatible)
# =============================================================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_minio_password
MINIO_BUCKET_EVIDENCE=janaseva-evidence
MINIO_BUCKET_DOCUMENTS=janaseva-documents
MINIO_USE_SSL=false

# For production S3:
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# S3_BUCKET=...

# =============================================================================
# AI / LLM (Google Gemini)
# =============================================================================
GEMINI_API_KEY=CHANGE_ME_get_from_aistudio_google_com
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.1

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@janaseva.demo
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM=JANASEVA OS <noreply@janaseva.demo>

# SMS (placeholder — wire to Twilio/MSG91 etc.)
SMS_PROVIDER=stub
SMS_API_KEY=CHANGE_ME

# Push notifications (placeholder)
PUSH_PROVIDER=stub
PUSH_API_KEY=CHANGE_ME

# =============================================================================
# FRONTEND (Next.js)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_MAPTILER_KEY=CHANGE_ME_free_at_maptiler_com
NEXT_PUBLIC_APP_NAME=JANASEVA OS
NEXT_PUBLIC_DEMO_MODE=true

# =============================================================================
# PGADMIN (local dev only)
# =============================================================================
PGADMIN_EMAIL=admin@janaseva.demo
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_password

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=20

# =============================================================================
# OBSERVABILITY
# =============================================================================
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# =============================================================================
# DEMO / SEED
# =============================================================================
SEED_DEMO_DATA=true
DEMO_DISTRICT_NAME=Krishnapur District
DEMO_STATE_NAME=Karnatapur
